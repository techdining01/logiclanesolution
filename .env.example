# Django
SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# Database (PostgreSQL - required in production)
DATABASE_URL=postgres://user:pass@host:5432/dbname

# Payvessel (required in production)
PAYVESSEL_API_KEY=your-api-key
PAYVESSEL_SECRET_KEY=your-secret-key
PAYVESSEL_BUSINESS_ID=your-business-id
PAYVESSEL_API_URL=https://api.payvessel.com

# Email (required in production)
DEFAULT_FROM_EMAIL=LogicLane Solutions <logiclanesolutions@gmail.com>
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=logiclanesolutions@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
